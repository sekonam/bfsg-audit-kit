# bfsg-audit-kit — environment template. Copy to .env and fill in.
# NEVER commit a real .env. No secrets belong in this repository.

# REQUIRED. The crawler refuses to start without a contact URL.
# It is sent in the User-Agent of every request so a site operator can identify
# and reach the operator of this bot. Must be an absolute http(s) URL.
BFSG_CONTACT_URL=https://example.de/bot

# Optional. Operator identity used in generated reports (not in requests).
BFSG_OPERATOR_NAME=Max Mustermann
BFSG_OPERATOR_EMAIL=kontakt@example.de

# Optional politeness overrides. The defaults are the conservative values and
# any override must be made deliberately and is logged on every run.
# Minimum delay between two requests to the SAME host, in milliseconds.
BFSG_MIN_REQUEST_INTERVAL_MS=2000
# Hard cap on pages fetched per shop.
BFSG_MAX_PAGES_PER_SHOP=20
# Set to "true" ONLY with documented permission from the site operator.
BFSG_IGNORE_ROBOTS=false

# Where scan artefacts, reports and baselines are written.
BFSG_DATA_DIR=./out
